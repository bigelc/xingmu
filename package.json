{
  "name": "xingmu-personal-workbench",
  "version": "2.0.0",
  "description": "醒目-个人效率工作台：本地待办、笔记、录音、AI 新闻与多平台 AI 用量管理",
  "main": "main.js",
  "author": "bigelc",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/test-desktop.js",
    "start": "electron .",
    "build": "electron-builder --mac dmg --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:zip": "electron-builder --mac zip --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.bigelc.xingmu",
    "productName": "醒目-个人效率工作台",
    "artifactName": "Xingmu-${version}-${arch}.${ext}",
    "copyright": "© 2026 bigelc; upstream contributors (see LICENSE)",
    "asar": false,
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "afterPack": "./build/afterPack.js",
    "files": [
      "LICENSE",
      "NOTICE.md",
      "main.js",
      "profile-directory.js",
      "main-services.js",
      "news-service.js",
      "article-service.js",
      "news-translation-service.js",
      "ai-providers.js",
      "ai-settings.js",
      "ai-client.js",
      "ai-usage.js",
      "account-usage.js",
      "ai-usage-import.js",
      "electron-article-fetch.js",
      "news-network.js",
      "platform.js",
      "build/xingmu-icon.png",
      "preload.js",
      "renderer/**/*",
      "scripts/codex-notify.js",
      "scripts/claude-notify.js",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}"
    ],
    "mac": {
      "icon": "build/xingmu-icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "CFBundleDisplayName": "醒目-个人效率工作台",
        "NSMicrophoneUsageDescription": "醒目-个人效率工作台 需要使用麦克风来录音并生成转写文本。",
        "NSAppleEventsUsageDescription": "醒目-个人效率工作台 需要控制「系统事件」来枚举并聚焦当前窗口、粘贴剪贴板内容。"
      },
      "identity": null
    },
    "win": {
      "icon": "build/xingmu-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xingmu-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "醒目-个人效率工作台 ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bigelc",
        "repo": "xingmu"
      }
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "unzipper": "^0.12.5",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bigelc/xingmu.git"
  },
  "homepage": "https://bigelc.github.io/xingmu/",
  "bugs": {
    "url": "https://github.com/bigelc/xingmu/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
